# ---------------------------------------------------------------------------
# Backend environment. Copy to .env for local development. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (docker compose exposes the dev database on host port 5433)
DATABASE_URL=postgresql://inventory:inventory@127.0.0.1:5433/inventory?schema=public
# Used by the integration test suite (separate database, wiped on every run)
DATABASE_URL_TEST=postgresql://inventory:inventory@127.0.0.1:5433/inventory_test?schema=public

# Comma-separated list of allowed browser origins (the Next.js frontend)
CORS_ORIGINS=http://localhost:3000
# Public URL of the frontend, used in password-reset links
APP_URL=http://localhost:3000
# Set when running behind a reverse proxy (number of hops), e.g. 1
TRUST_PROXY=0

# Auth — generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true

# Mail (docker compose runs Mailpit: SMTP on 1025, web UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Inventory System <no-reply@inventory.local>"

# Product image storage (local disk / Docker volume)
UPLOAD_DIR=uploads

# API docs (Swagger UI at /api/docs). Defaults to enabled outside production.
SWAGGER_ENABLED=true

# Initial administrator created by `npm run db:seed`
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
