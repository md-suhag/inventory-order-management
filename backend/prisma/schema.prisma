// =============================================================================
// Mini Inventory & Order Management System — PostgreSQL schema (Prisma 6)
//
// Conventions
//   * Tables/columns are snake_case (@@map / @map); Prisma models are PascalCase.
//   * Primary keys are time-ordered UUIDv7 (good B-tree locality), except
//     singleton/lookup tables with natural keys.
//   * Money: numeric(14,2). Unit cost / weighted-average cost: numeric(14,4).
//     Rates (percent, 0–100): numeric(7,4). Never floating point.
//   * Quantities: integer, in the product's base unit of measure.
//   * Timestamps: timestamptz(3), stored in UTC. Business-timezone bucketing is
//     done at query time using business_settings.timezone.
//   * CHECK constraints, append-only triggers and the pg_trgm extension are not
//     expressible in Prisma and live in the hand-written section of the
//     migration SQL (see prisma/sql/constraints.sql and docs/database).
//
// Denormalised fields (each has a single writer, updated in the same
// transaction under a row lock — see DATABASE_DESIGN.md §6):
//   products.stock_quantity, products.cost_price (WAC),
//   purchase_items.received_quantity,
//   purchases.{paid_amount, refunded_amount, payment_status},
//   orders.{paid_amount, refunded_amount, returned_amount, payment_status}
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DocumentType {
  ORDER
  INVOICE
  PURCHASE
  PURCHASE_RECEIPT
  PAYMENT
  SALES_RETURN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentType {
  PAYMENT // money in from a customer / money out to a supplier
  REFUND // money flowing back in the opposite direction
  REVERSAL // voids an erroneous PAYMENT or REFUND record (never edits it)
}

enum SalesReturnStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum ReturnItemCondition {
  RESALABLE // restocked via SALE_RETURN movement
  DAMAGED // credited to the customer, NOT restocked
}

enum InventoryMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE
  SALE_CANCELLATION
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum AdjustmentReason {
  COUNT_CORRECTION
  DAMAGED
  EXPIRED
  LOST
  STOLEN
  FOUND
  OTHER
}

// -----------------------------------------------------------------------------
// Business configuration
// -----------------------------------------------------------------------------

/// Singleton row (id = 1, enforced by CHECK). Single-business deployment.
model BusinessSetting {
  id                       Int      @id @default(1)
  businessName             String   @map("business_name") @db.VarChar(150)
  legalName                String?  @map("legal_name") @db.VarChar(150)
  taxRegistrationNumber    String?  @map("tax_registration_number") @db.VarChar(50)
  email                    String?  @db.VarChar(254)
  phone                    String?  @db.VarChar(30)
  address                  String?  @db.Text
  logoPath                 String?  @map("logo_path") @db.VarChar(255)
  currencyCode             String   @default("USD") @map("currency_code") @db.Char(3)
  locale                   String   @default("en-US") @db.VarChar(20)
  timezone                 String   @default("UTC") @db.VarChar(64)
  taxEnabled               Boolean  @default(false) @map("tax_enabled")
  taxLabel                 String   @default("Tax") @map("tax_label") @db.VarChar(30)
  defaultTaxRate           Decimal  @default(0) @map("default_tax_rate") @db.Decimal(7, 4)
  invoiceFooter            String?  @map("invoice_footer") @db.Text
  defaultLowStockThreshold Int      @default(10) @map("default_low_stock_threshold")
  lowStockAlertsEnabled    Boolean  @default(true) @map("low_stock_alerts_enabled")
  allowSelfRegistration    Boolean  @default(false) @map("allow_self_registration")
  updatedById              String?  @map("updated_by_id") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("business_settings")
}

/// Gap-free document numbering (row-locked increment inside the business transaction).
model DocumentSequence {
  documentType DocumentType @id @map("document_type")
  prefix       String       @db.VarChar(10)
  nextNumber   Int          @default(1) @map("next_number")
  padding      Int          @default(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("document_sequences")
}

model PaymentMethod {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments Payment[]

  @@map("payment_methods")
}

// -----------------------------------------------------------------------------
// Identity, access control, sessions, audit
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// Permission keys are defined in code (source of truth) and synced by the seed.
model Permission {
  key         String  @id @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

/// Junction table: roles <-> permissions (many-to-many).
model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key") @db.VarChar(100)
  grantedAt     DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String    @db.VarChar(100)
  email               String    @unique @db.VarChar(254) /// stored lower-cased
  phone               String?   @db.VarChar(30)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  roleId              String    @map("role_id") @db.Uuid
  isActive            Boolean   @default(true) @map("is_active")
  tokenVersion        Int       @default(0) @map("token_version") /// bump to invalidate issued access tokens
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdById         String?   @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdUsers        User[]               @relation("UserCreatedBy")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  settingsUpdates     BusinessSetting[]    @relation("SettingsUpdatedBy")
  purchasesCreated    Purchase[]           @relation("PurchaseCreatedBy")
  purchasesCancelled  Purchase[]           @relation("PurchaseCancelledBy")
  purchaseReceipts    PurchaseReceipt[]
  ordersCreated       Order[]              @relation("OrderCreatedBy")
  ordersConfirmed     Order[]              @relation("OrderConfirmedBy")
  ordersCompleted     Order[]              @relation("OrderCompletedBy")
  ordersCancelled     Order[]              @relation("OrderCancelledBy")
  paymentsRecorded    Payment[]
  returnsRequested    SalesReturn[]        @relation("ReturnRequestedBy")
  returnsProcessed    SalesReturn[]        @relation("ReturnProcessedBy")
  inventoryMovements  InventoryMovement[]

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

/// Opaque refresh tokens (only SHA-256 hash stored). Rotation chain via replaced_by_token_id;
/// family_id groups a login session for reuse detection / family revocation.
model RefreshToken {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(50)
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid
  createdByIp       String?   @map("created_by_ip") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Append-only (UPDATE/DELETE blocked by trigger). Written in the same transaction as the audited change.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid /// null = system process
  action     String   @db.VarChar(100) /// e.g. "order.confirmed"
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------

model Category {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String       @unique @db.VarChar(100)
  description String?      @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([status])
  @@map("categories")
}

model Product {
  id            String        @id @default(uuid(7)) @db.Uuid
  sku           String        @unique @db.VarChar(64) /// normalised upper-case
  barcode       String?       @unique @db.VarChar(64)
  name          String        @db.VarChar(200)
  description   String?       @db.Text
  categoryId    String?       @map("category_id") @db.Uuid
  unit          String        @default("pcs") @db.VarChar(20)
  costPrice     Decimal       @default(0) @map("cost_price") @db.Decimal(14, 4) /// weighted average cost
  sellingPrice  Decimal       @map("selling_price") @db.Decimal(14, 2)
  taxRate       Decimal?      @map("tax_rate") @db.Decimal(7, 4) /// null = business default rate
  stockQuantity Int           @default(0) @map("stock_quantity") /// only changed with an inventory_movements row
  reorderLevel  Int?          @map("reorder_level") /// null = business default threshold
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  purchaseItems      PurchaseItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid(7)) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  filePath     String   @map("file_path") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(50)
  sizeBytes    Int      @map("size_bytes")
  sortOrder    Int      @default(0) @map("sort_order") /// 0 = primary image
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// -----------------------------------------------------------------------------
// Parties
// -----------------------------------------------------------------------------

model Supplier {
  id            String       @id @default(uuid(7)) @db.Uuid
  name          String       @db.VarChar(150)
  contactPerson String?      @map("contact_person") @db.VarChar(100)
  phone         String?      @db.VarChar(30)
  email         String?      @db.VarChar(254)
  address       String?      @db.Text
  notes         String?      @db.Text
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchases Purchase[]

  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "suppliers_name_trgm_idx")
  @@map("suppliers")
}

model Customer {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String       @db.VarChar(150)
  phone     String?      @db.VarChar(30)
  email     String?      @db.VarChar(254)
  address   String?      @db.Text
  notes     String?      @db.Text
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@map("customers")
}

// -----------------------------------------------------------------------------
// Purchasing
// -----------------------------------------------------------------------------

model Purchase {
  id                   String         @id @default(uuid(7)) @db.Uuid
  purchaseNumber       String         @unique @map("purchase_number") @db.VarChar(30)
  supplierId           String         @map("supplier_id") @db.Uuid
  status               PurchaseStatus @default(DRAFT)
  paymentStatus        PaymentStatus  @default(UNPAID) @map("payment_status")
  supplierReference    String?        @map("supplier_reference") @db.VarChar(100) /// supplier invoice no.
  expectedDeliveryDate DateTime?      @map("expected_delivery_date") @db.Date
  subtotal             Decimal        @default(0) @db.Decimal(14, 2) /// Σ(line gross − line discount)
  discountType         DiscountType?  @map("discount_type")
  discountValue        Decimal?       @map("discount_value") @db.Decimal(14, 4)
  discountAmount       Decimal        @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount            Decimal        @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount          Decimal        @default(0) @map("total_amount") @db.Decimal(14, 2)
  paidAmount           Decimal        @default(0) @map("paid_amount") @db.Decimal(14, 2)
  refundedAmount       Decimal        @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  notes                String?        @db.Text
  createdById          String         @map("created_by_id") @db.Uuid
  orderedAt            DateTime?      @map("ordered_at") @db.Timestamptz(3)
  receivedAt           DateTime?      @map("received_at") @db.Timestamptz(3) /// fully received
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?        @map("cancelled_by_id") @db.Uuid
  cancellationReason   String?        @map("cancellation_reason") @db.VarChar(500)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier    Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy User?             @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  items       PurchaseItem[]
  receipts    PurchaseReceipt[]
  payments    Payment[]

  @@index([supplierId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderedAt])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id                String  @id @default(uuid(7)) @db.Uuid
  purchaseId        String  @map("purchase_id") @db.Uuid
  productId         String  @map("product_id") @db.Uuid
  lineNo            Int     @map("line_no")
  productName       String  @map("product_name") @db.VarChar(200) /// snapshot
  productSku        String  @map("product_sku") @db.VarChar(64) /// snapshot
  quantity          Int
  receivedQuantity  Int     @default(0) @map("received_quantity")
  unitCost          Decimal @map("unit_cost") @db.Decimal(14, 2)
  discountAmount    Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  allocatedDiscount Decimal @default(0) @map("allocated_discount") @db.Decimal(14, 2) /// share of header discount
  taxRate           Decimal @default(0) @map("tax_rate") @db.Decimal(7, 4)
  taxAmount         Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(14, 2) /// incl. tax

  purchase     Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems PurchaseReceiptItem[]

  @@unique([purchaseId, productId])
  @@unique([purchaseId, lineNo])
  @@index([productId])
  @@map("purchase_items")
}

/// One physical delivery against a purchase. Append-only.
model PurchaseReceipt {
  id             String   @id @default(uuid(7)) @db.Uuid
  receiptNumber  String   @unique @map("receipt_number") @db.VarChar(30)
  purchaseId     String   @map("purchase_id") @db.Uuid
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  receivedById   String   @map("received_by_id") @db.Uuid
  notes          String?  @db.Text
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchase           Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  receivedBy         User                  @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  items              PurchaseReceiptItem[]
  inventoryMovements InventoryMovement[]

  @@index([purchaseId])
  @@index([receivedAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  receiptId      String  @map("receipt_id") @db.Uuid
  purchaseItemId String  @map("purchase_item_id") @db.Uuid
  quantity       Int
  unitCost       Decimal @map("unit_cost") @db.Decimal(14, 4) /// net unit cost (after discounts, excl. tax) blended into WAC

  receipt      PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseItem PurchaseItem    @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  @@unique([receiptId, purchaseItemId])
  @@index([purchaseItemId])
  @@map("purchase_receipt_items")
}

// -----------------------------------------------------------------------------
// Sales
// -----------------------------------------------------------------------------

model Order {
  id                 String        @id @default(uuid(7)) @db.Uuid
  orderNumber        String        @unique @map("order_number") @db.VarChar(30)
  invoiceNumber      String?       @unique @map("invoice_number") @db.VarChar(30) /// assigned on confirmation
  customerId         String?       @map("customer_id") @db.Uuid /// null = walk-in customer
  customerName       String?       @map("customer_name") @db.VarChar(150) /// billing snapshot
  customerPhone      String?       @map("customer_phone") @db.VarChar(30)
  customerAddress    String?       @map("customer_address") @db.Text
  status             OrderStatus   @default(DRAFT)
  paymentStatus      PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal           Decimal       @default(0) @db.Decimal(14, 2) /// Σ(line gross − line discount)
  discountType       DiscountType? @map("discount_type")
  discountValue      Decimal?      @map("discount_value") @db.Decimal(14, 4)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount          Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount        Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  paidAmount         Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  refundedAmount     Decimal       @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  returnedAmount     Decimal       @default(0) @map("returned_amount") @db.Decimal(14, 2) /// credit from completed returns
  notes              String?       @db.Text
  createdById        String        @map("created_by_id") @db.Uuid
  confirmedById      String?       @map("confirmed_by_id") @db.Uuid
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  completedById      String?       @map("completed_by_id") @db.Uuid
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(3)
  cancelledById      String?       @map("cancelled_by_id") @db.Uuid
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?       @map("cancellation_reason") @db.VarChar(500)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy        User?               @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  completedBy        User?               @relation("OrderCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy        User?               @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  items              OrderItem[]
  payments           Payment[]
  salesReturns       SalesReturn[]
  inventoryMovements InventoryMovement[]

  @@index([customerId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([confirmedAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid(7)) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  lineNo            Int      @map("line_no")
  productName       String   @map("product_name") @db.VarChar(200) /// snapshot
  productSku        String   @map("product_sku") @db.VarChar(64) /// snapshot
  unit              String   @db.VarChar(20) /// snapshot
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(14, 2) /// snapshot
  unitCost          Decimal? @map("unit_cost") @db.Decimal(14, 4) /// WAC snapshot at confirmation (COGS)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(14, 2)
  allocatedDiscount Decimal  @default(0) @map("allocated_discount") @db.Decimal(14, 2)
  taxRate           Decimal  @default(0) @map("tax_rate") @db.Decimal(7, 4)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(14, 2) /// incl. tax

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems SalesReturnItem[]

  @@unique([orderId, productId])
  @@unique([orderId, lineNo])
  @@index([productId])
  @@map("order_items")
}

// -----------------------------------------------------------------------------
// Payments (immutable ledger for both orders and purchases)
// -----------------------------------------------------------------------------

model Payment {
  id                String      @id @default(uuid(7)) @db.Uuid
  paymentNumber     String      @unique @map("payment_number") @db.VarChar(30)
  type              PaymentType
  orderId           String?     @map("order_id") @db.Uuid
  purchaseId        String?     @map("purchase_id") @db.Uuid
  salesReturnId     String?     @map("sales_return_id") @db.Uuid /// refund issued for a return
  paymentMethodId   String      @map("payment_method_id") @db.Uuid
  amount            Decimal     @db.Decimal(14, 2) /// always positive; direction comes from type
  paidAt            DateTime    @default(now()) @map("paid_at") @db.Timestamptz(3)
  reference         String?     @db.VarChar(100)
  notes             String?     @db.Text
  reversedPaymentId String?     @unique @map("reversed_payment_id") @db.Uuid
  idempotencyKey    String?     @unique @map("idempotency_key") @db.VarChar(100)
  recordedById      String      @map("recorded_by_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  order           Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  purchase        Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  salesReturn     SalesReturn?  @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  recordedBy      User          @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  reversedPayment Payment?      @relation("PaymentReversal", fields: [reversedPaymentId], references: [id], onDelete: Restrict)
  reversal        Payment?      @relation("PaymentReversal")

  @@index([orderId])
  @@index([purchaseId])
  @@index([salesReturnId])
  @@index([paymentMethodId])
  @@index([type, paidAt])
  @@index([paidAt])
  @@map("payments")
}

// -----------------------------------------------------------------------------
// Sales returns
// -----------------------------------------------------------------------------

model SalesReturn {
  id              String            @id @default(uuid(7)) @db.Uuid
  returnNumber    String            @unique @map("return_number") @db.VarChar(30)
  orderId         String            @map("order_id") @db.Uuid
  status          SalesReturnStatus @default(PENDING)
  reason          String            @db.VarChar(500)
  notes           String?           @db.Text
  subtotal        Decimal           @default(0) @db.Decimal(14, 2) /// credit excl. tax
  taxAmount       Decimal           @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount     Decimal           @default(0) @map("total_amount") @db.Decimal(14, 2)
  requestedById   String            @map("requested_by_id") @db.Uuid
  processedById   String?           @map("processed_by_id") @db.Uuid
  processedAt     DateTime?         @map("processed_at") @db.Timestamptz(3)
  rejectionReason String?           @map("rejection_reason") @db.VarChar(500)
  idempotencyKey  String?           @unique @map("idempotency_key") @db.VarChar(100)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy        User                @relation("ReturnRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  processedBy        User?               @relation("ReturnProcessedBy", fields: [processedById], references: [id], onDelete: Restrict)
  items              SalesReturnItem[]
  refunds            Payment[]
  inventoryMovements InventoryMovement[]

  @@index([orderId])
  @@index([status])
  @@index([processedAt])
  @@index([createdAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String              @id @default(uuid(7)) @db.Uuid
  salesReturnId String              @map("sales_return_id") @db.Uuid
  orderItemId   String              @map("order_item_id") @db.Uuid
  quantity      Int
  condition     ReturnItemCondition
  subtotal      Decimal             @db.Decimal(14, 2) /// credit excl. tax
  taxAmount     Decimal             @map("tax_amount") @db.Decimal(14, 2)
  totalAmount   Decimal             @map("total_amount") @db.Decimal(14, 2)

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([salesReturnId, orderItemId])
  @@index([orderItemId])
  @@map("sales_return_items")
}

// -----------------------------------------------------------------------------
// Inventory ledger (append-only)
// -----------------------------------------------------------------------------

/// Every change to products.stock_quantity writes exactly one row here, in the same transaction.
/// Reference FK columns are mutually exclusive and tied to `type` by CHECK constraints.
model InventoryMovement {
  id                String                @id @default(uuid(7)) @db.Uuid
  productId         String                @map("product_id") @db.Uuid
  type              InventoryMovementType
  quantityChange    Int                   @map("quantity_change") /// signed
  previousStock     Int                   @map("previous_stock")
  resultingStock    Int                   @map("resulting_stock")
  unitCost          Decimal?              @map("unit_cost") @db.Decimal(14, 4)
  purchaseReceiptId String?               @map("purchase_receipt_id") @db.Uuid
  orderId           String?               @map("order_id") @db.Uuid
  salesReturnId     String?               @map("sales_return_id") @db.Uuid
  adjustmentReason  AdjustmentReason?     @map("adjustment_reason")
  notes             String?               @db.Text
  idempotencyKey    String?               @unique @map("idempotency_key") @db.VarChar(100)
  performedById     String                @map("performed_by_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseReceipt PurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id], onDelete: Restrict)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  salesReturn     SalesReturn?     @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  performedBy     User             @relation(fields: [performedById], references: [id], onDelete: Restrict)

  // DB-level exactly-once guarantees (NULLs are distinct, so rows of other types never collide):
  @@unique([orderId, productId, type]) // one SALE and at most one SALE_CANCELLATION per order line
  @@unique([purchaseReceiptId, productId]) // one movement per product per receipt
  @@unique([salesReturnId, productId]) // one restock movement per product per return
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("inventory_movements")
}
