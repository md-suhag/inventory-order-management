# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env.local for local development. Never commit .env*.
# ---------------------------------------------------------------------------

# Server-only URL of the Express API (never exposed to browser JS)
API_BASE_URL=http://localhost:4000/api/v1

# Public URL of this Next.js frontend
APP_URL=http://localhost:3000

# Set to "true" in HTTPS production deployments
SESSION_COOKIE_SECURE=false
