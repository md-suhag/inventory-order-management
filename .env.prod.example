# ---------------------------------------------------------------------------
# Production environment template for docker-compose.prod.yml
# Copy to .env.prod (never commit real secrets):
#   cp .env.prod.example .env.prod
# ---------------------------------------------------------------------------

# PostgreSQL superuser/migration owner (used by postgres + migrate services)
POSTGRES_USER=inventory
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=inventory

# Optional least-privilege runtime DB connection for the backend API after running
# scripts/db/harden-app-role.sql (defaults to the owner connection if omitted):
# APP_DATABASE_URL=postgresql://inventory_app:replace-with-app-password@postgres:5432/inventory?schema=public

# Public domain behind TLS reverse proxy
APP_URL=https://inventory.example.com
CORS_ORIGINS=https://inventory.example.com
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
TRUST_PROXY=1
SESSION_COOKIE_SECURE=true

# Auth — MUST be a unique >= 32-char random secret without "change-me":
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-48-byte-random-base64url-production-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true

# SMTP (required when NODE_ENV=production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-username
SMTP_PASS=replace-with-smtp-password
MAIL_FROM="Inventory System <no-reply@example.com>"

# Logging & docs
LOG_LEVEL=info
SWAGGER_ENABLED=false

# Initial administrator account (used once if no ADMIN user exists; rotate password after first login)
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ReplaceWithStrongInitialPass1
