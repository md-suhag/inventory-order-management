e=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-1869" target="r-1742"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2007" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-1504" target="r-1747"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2008" value="" style="edgeStyle=orthogonalEdgeStyle;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="r-1717" target="r-1772"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e-2009" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-1551" target="r-1879"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2010" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-1869" target="r-1955"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2011" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-1793" target="r-1960"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend-2012" value="&lt;b&gt;Notation&lt;/b&gt; (Crow's Foot)&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; foreign key &amp;nbsp; &lt;b&gt;UK&lt;/b&gt; unique&lt;br&gt;&lt;u&gt;underlined&lt;/u&gt; = primary-key column&lt;br&gt;&lt;i&gt;NULL&lt;/i&gt; = nullable column (blank = NOT NULL)&lt;br&gt;&lt;span style=&quot;color:#1F5FAD&quot;&gt;type → table&lt;/span&gt; = FK whose line is not drawn here&lt;br&gt;Dashed table = reference stub (detailed on another page)&lt;br&gt;&lt;br&gt;&lt;b&gt;Line ends&lt;/b&gt;&lt;br&gt;┤├ exactly one &amp;nbsp;&amp;nbsp; o┤ zero or one&lt;br&gt;o&amp;lt; zero or many &amp;nbsp;&amp;nbsp; ┤&amp;lt; one or many&lt;br&gt;&lt;br&gt;Composite / multi-column UNIQUE constraints, CHECK&lt;br&gt;constraints and append-only triggers are listed in&lt;br&gt;docs/database/DATABASE_DESIGN.md." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FAFAFA;strokeColor=#C8CDD3;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1360" y="520" width="340" height="250" as="geometry"/></mxCell><mxCell id="note-2013" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• payments targets exactly one of order_id / purchase_id (CHECK num_nonnulls = 1).&lt;br&gt;• payments.reversed_payment_id: 1:1 self-reference; a payment can be reversed once.&lt;br&gt;• payments is append-only; corrections are REVERSAL rows.&lt;br&gt;• customer_id NULL = walk-in customer; customer_* columns are billing snapshots.&lt;br&gt;• UNIQUE (order_id, product_id), (order_id, line_no) on order_items; (sales_return_id, order_item_id) on sales_return_items." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FFF8E1;strokeColor=#E0C068;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1360" y="800" width="340" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram>
