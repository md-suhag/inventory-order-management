tartSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-784" target="r-891"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-983" value="" style="edgeStyle=orthogonalEdgeStyle;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="r-886" target="r-921"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="e-984" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-784" target="r-947"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend-985" value="&lt;b&gt;Notation&lt;/b&gt; (Crow's Foot)&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; foreign key &amp;nbsp; &lt;b&gt;UK&lt;/b&gt; unique&lt;br&gt;&lt;u&gt;underlined&lt;/u&gt; = primary-key column&lt;br&gt;&lt;i&gt;NULL&lt;/i&gt; = nullable column (blank = NOT NULL)&lt;br&gt;&lt;span style=&quot;color:#1F5FAD&quot;&gt;type → table&lt;/span&gt; = FK whose line is not drawn here&lt;br&gt;Dashed table = reference stub (detailed on another page)&lt;br&gt;&lt;br&gt;&lt;b&gt;Line ends&lt;/b&gt;&lt;br&gt;┤├ exactly one &amp;nbsp;&amp;nbsp; o┤ zero or one&lt;br&gt;o&amp;lt; zero or many &amp;nbsp;&amp;nbsp; ┤&amp;lt; one or many&lt;br&gt;&lt;br&gt;Composite / multi-column UNIQUE constraints, CHECK&lt;br&gt;constraints and append-only triggers are listed in&lt;br&gt;docs/database/DATABASE_DESIGN.md." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FAFAFA;strokeColor=#C8CDD3;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1360" y="80" width="340" height="250" as="geometry"/></mxCell><mxCell id="note-986" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• roles ⟷ permissions is many-to-many, resolved by role_permissions (composite PK).&lt;br&gt;• refresh_tokens.replaced_by_token_id is a 1:1 self-reference forming the rotation chain; family_id groups one login session.&lt;br&gt;• business_settings is a singleton (CHECK id = 1).&lt;br&gt;• Users are never hard-deleted (deactivated), so actor FKs elsewhere use ON DELETE RESTRICT." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FFF8E1;strokeColor=#E0C068;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1360" y="360" width="340" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram>
