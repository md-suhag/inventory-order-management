hidden;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=left;spacingLeft=2;fontColor=#333333;" vertex="1" parent="r-2192"><mxGeometry x="200" width="146" height="22" as="geometry"><mxRectangle width="146" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="c-2196" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;align=center;fontColor=#999999;fontStyle=2;fontSize=9;" vertex="1" parent="r-2192"><mxGeometry x="346" width="40" height="22" as="geometry"><mxRectangle width="40" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="e-2197" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-2136" target="r-2152"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2198" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-2016" target="r-2065"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2199" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-2027" target="r-2095"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2200" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-2038" target="r-2100"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2201" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-2049" target="r-2105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2202" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=10;endSize=10;rounded=0;html=1;strokeColor=#5F6B7A;strokeWidth=1.2;" edge="1" parent="1" source="r-2136" target="r-2125"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend-2203" value="&lt;b&gt;Notation&lt;/b&gt; (Crow's Foot)&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; foreign key &amp;nbsp; &lt;b&gt;UK&lt;/b&gt; unique&lt;br&gt;&lt;u&gt;underlined&lt;/u&gt; = primary-key column&lt;br&gt;&lt;i&gt;NULL&lt;/i&gt; = nullable column (blank = NOT NULL)&lt;br&gt;&lt;span style=&quot;color:#1F5FAD&quot;&gt;type → table&lt;/span&gt; = FK whose line is not drawn here&lt;br&gt;Dashed table = reference stub (detailed on another page)&lt;br&gt;&lt;br&gt;&lt;b&gt;Line ends&lt;/b&gt;&lt;br&gt;┤├ exactly one &amp;nbsp;&amp;nbsp; o┤ zero or one&lt;br&gt;o&amp;lt; zero or many &amp;nbsp;&amp;nbsp; ┤&amp;lt; one or many&lt;br&gt;&lt;br&gt;Composite / multi-column UNIQUE constraints, CHECK&lt;br&gt;constraints and append-only triggers are listed in&lt;br&gt;docs/database/DATABASE_DESIGN.md." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FAFAFA;strokeColor=#C8CDD3;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1360" y="380" width="340" height="250" as="geometry"/></mxCell><mxCell id="note-2204" value="&lt;b&gt;inventory_movements rules (CHECK constraints)&lt;/b&gt;&lt;br&gt;• resulting_stock = previous_stock + quantity_change; both ≥ 0; quantity_change ≠ 0.&lt;br&gt;• Sign by type: SALE, ADJUSTMENT_OUT &amp;lt; 0; all other types &amp;gt; 0.&lt;br&gt;• Exactly the reference FK matching the type is set (receipt / order / return); OPENING_STOCK and adjustments have none.&lt;br&gt;• adjustment_reason required iff type is ADJUSTMENT_IN/OUT; reason OTHER requires notes.&lt;br&gt;• UNIQUE (order_id, product_id, type), (purchase_receipt_id, product_id), (sales_return_id, product_id) give DB-level exactly-once stock effects.&lt;br&gt;• inventory_movements and audit_logs reject UPDATE/DELETE (trigger)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;fontSize=11;fillColor=#FFF8E1;strokeColor=#E0C068;arcSize=3;" vertex="1" parent="1"><mxGeometry x="480" y="500" width="780" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
